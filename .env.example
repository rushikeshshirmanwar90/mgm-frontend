# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# Only variables prefixed EXPO_PUBLIC_ are readable by the app at runtime.
# They are embedded in the JS bundle, so never put secrets here.

# ---- Backend API ----
# Leave unset for simulator / web development: the app then derives your machine's
# LAN address from the Expo dev server automatically.
# Set it explicitly for a physical device on a different network, or for a
# deployed backend. No trailing slash, and no /api suffix.
# EXPO_PUBLIC_API_URL=http://192.168.1.42:3000
#
# Port used when auto-detecting the host (defaults to 3000, matching `next dev`).
# EXPO_PUBLIC_API_PORT=3000

# ---- Cloudinary (required for complaint photo uploads) ----
# Create an UNSIGNED upload preset:
#   Cloudinary console -> Settings -> Upload -> Upload presets -> Add
#   Signing mode: Unsigned
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
